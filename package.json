{
  "name": "perfdigest-plugin",
  "version": "0.1.0",
  "description": "Evidence-driven performance debugging for Codex: PerfDigest MCP evidence, lightweight decision routing (Cloudflare/local Clef-flash, OpenAI, offline) and independent verification",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/onlyxItachi/perfdigest-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "perfdigest-plugin": "dist/perfdigest-plugin"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "!examples/**/.perfdigest",
    "skills",
    ".codex-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE",
    "docs",
    "go.mod",
    "cmd",
    "internal",
    "scripts/build-go.mjs",
    "scripts/ensure-binary.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-go.mjs",
    "postinstall": "node scripts/ensure-binary.mjs",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "demo": "./dist/perfdigest-plugin demo",
    "prepack": "npm run build",
    "test:local": "npm run build && node scripts/check-local.mjs",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:bench-regression": "npm run build && node scripts/check-bench-regression.mjs",
    "test:decisions-live": "node scripts/check-decisions-live.mjs",
    "check": "npm run build && npm test && npm run test:local && npm run test:decisions-http && npm run test:package && npm run test:bench-regression",
    "plugin:prepare": "node scripts/prepare-plugin.mjs",
    "benchmark:evidence": "npm run build && node scripts/benchmark.mjs",
    "test:decisions-http": "npm run build && node scripts/check-decisions-http.mjs",
    "test:decisions-auth-boundary": "node scripts/check-decisions-auth-boundary.mjs",
    "test:clef-live": "node scripts/check-clef-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex-sdk": "0.162.1",
    "openai": "7.32.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
