{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "perfdigest.regression-corpus.v1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "upstreamRepo": {
      "type": "string",
      "const": "onlyxItachi/PerfDigest-MCP-Bench"
    },
    "studies": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "studyDoc": {
            "type": "string",
            "minLength": 1
          },
          "rawDir": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "expectedSelectedReportId": {
            "type": "string",
            "minLength": 1
          },
          "reports": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "expectedDigest": {
                  "type": "object",
                  "properties": {
                    "totalUnits": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "topUnitName": {
                      "type": "string",
                      "minLength": 1
                    },
                    "topUnitIndex": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "topUnitDomain": {
                      "type": "string",
                      "minLength": 1
                    },
                    "topUnitMetrics": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "totalUnits",
                    "topUnitName",
                    "topUnitIndex",
                    "topUnitDomain",
                    "topUnitMetrics"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "path",
                "format",
                "bytes",
                "sha256",
                "expectedDigest"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "studyDoc",
          "rawDir",
          "question",
          "expectedSelectedReportId",
          "reports"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "createdAt",
    "upstreamRepo",
    "studies"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/onlyxItachi/perfdigest-plugin/bench/schema/regression-corpus.v1.schema.json",
  "title": "PerfDigest Cross-Repo Real-Workload Regression Corpus v1"
}
